# Copy to .env.production, fill only non-secret deployment values, and chmod 0600.
# Secret values belong in individual files under ./secrets (see secrets/README.md).

TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash
TRADINGAGENTS_OUTPUT_LANGUAGE=English

# Comma-separated HTTPS feed URLs.
RSS_FEEDS=https://example.com/feed.xml

# Telegram ingestion account. Channel handles may omit the leading @.
TELEGRAM_SENSING_CHANNELS=example_channel

# Private delivery/callback target. Production accepts exactly one operator id.
TELEGRAM_BOT_ALLOWED_CHAT_IDS=123456789

# Email delivery metadata. Credentials are Docker secrets.
IIC_SMTP_ENABLED=true
IIC_SMTP_HOST=smtp.example.com
IIC_SMTP_PORT=587
IIC_SMTP_FROM_ADDR=forge@example.com
IIC_SMTP_TO_ADDRS=operator@example.com

# Polygon reference seeding is free-tier safe by default; use 0 on a paid plan.
POLYGON_SEED_THROTTLE_S=13
POLYGON_SEED_MAX_RETRIES=6
